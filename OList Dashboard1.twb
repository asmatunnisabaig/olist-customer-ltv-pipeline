      <aliases enabled='yes' />
      <column caption='Calc_Customer_LTV' datatype='real' name='[Calculation_0372736269135873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ltv_estimate] * [attribution_weight]' />
      </column>
      <column caption='Calc_ROAS' datatype='real' name='[Calculation_0372736269606914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_revenue] * [attribution_weight])) / SUM([spend])' />
      </column>
      <column caption='Calc_Attributed_Revenue' datatype='real' name='[Calculation_0372736270090244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_revenue] * [attribution_weight]' />
      </column>
      <column caption='LTV Decile' datatype='real' name='[Calculation_0372736289394693]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK_PERCENTILE(SUM([Calculation_0372736269135873]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='First Purchase Date' datatype='date' datatype-customized='true' name='[Calculation_0372736301228040]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE({ FIXED [customer_unique_id] : MIN([order_purchase_timestamp]) })' />
      </column>
      <column caption='Months Since Start' datatype='integer' name='[Calculation_0372736303534089]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_0372736301228040], [order_purchase_timestamp])' />
      </column>
      <column caption='Top 10% LTV' datatype='real' name='[Calculation_0372736409272331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0372736289394693] &gt;= 0.9 THEN SUM([Calculation_0372736269135873]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Channel High-Value Metric' datatype='real' name='[Calculation_0372736413650959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [channel] : AVG(&#10;    IF [Calculation_0372736269135873] &gt; { FIXED : PERCENTILE([Calculation_0372736269135873], 0.9) } &#10;    THEN [Calculation_0372736269135873] &#10;    END&#10;)}' />
      </column>
